{
  "name": "simu-map-editor",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-based terrain heightmap editor for Simutrans",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "npm run lint:docs && npm run typecheck",
    "lint:docs": "docs-lint",
    "validate:heightmaps": "powershell -NoProfile -File tools/validation/build-probe.ps1 && node tools/validation/verify-heightmaps.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "dev": "vite --host 127.0.0.1",
    "validate:prototype": "npm run validate:heightmaps && npm test && npm run build && npm run test:browser",
    "build": "npm run typecheck && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "benchmark:cpu": "node --experimental-strip-types tools/validation/benchmark-cpu.mjs",
    "benchmark:browser": "playwright test --config playwright.perf.config.ts",
    "performance:export": "node tools/validation/performance-history.mjs export"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "docs-lint": "github:128na/docs-lint#v1.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "type": "module"
}
