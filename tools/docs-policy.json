{
  "$comment": "docs-lint init new で生成。",
  "scanRoots": {
    "recursive": [
      "docs"
    ],
    "flat": [
      "."
    ]
  },
  "ledgers": [
    "docs/dependency-debt.md"
  ],
  "recordDirs": [
    "docs/records"
  ],
  "adrDir": "docs/adr",
  "templateDir": "docs/templates",
  "forbiddenFileNames": [
    "INDEX.md",
    "index.md",
    "TODO.md"
  ],
  "forbiddenDirNames": [
    "temp",
    "tmp",
    "draft",
    "wip"
  ],
  "dependencyDebtHeader": "| Package | Current | Target | Blocker | Type | Revisit condition | Recorded |",
  "dependencyDebtTypes": [
    "temporary",
    "infra",
    "behavior-change"
  ],
  "livingDocs": [
    "README.md",
    "CLAUDE.md",
    "AGENTS.md",
    "docs/README.md"
  ]
}
